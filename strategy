<!DOCTYPE html>
<html lang="am">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FIC— Fake Out · Order Flow Shift · Flip</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Ethiopic:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a0d10;
    --bg-chart:#05070a;
    --panel:#11161b;
    --panel-2:#0d1216;
    --border:#1e2730;
    --border-soft:#161d24;
    --text:#e8edf1;
    --muted:#8a97a2;
    --muted-2:#5f6a73;
    --buy:#20b2a0;
    --buy-soft:#20b2a022;
    --sell:#ef5654;
    --sell-soft:#ef565422;
    --gold:#e3a94a;
    --gold-soft:#e3a94a1f;
    --blue:#4f90f2;
    --blue-soft:#4f90f21f;
  }

  * { box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  html,body{
    margin:0; padding:0; background:var(--bg); color:var(--text);
    font-family:'Noto Sans Ethiopic','IBM Plex Mono',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .mono{ font-family:'IBM Plex Mono',monospace; }

  ::selection{ background:var(--gold); color:#0a0d10; }

  /* ---------- background grid texture ---------- */
  body{
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 42px 42px;
    background-position: center top;
  }

  /* ---------- sticky ticker nav ---------- */
  .navbar{
    position:sticky; top:0; z-index:50;
    background:rgba(10,13,16,0.86);
    backdrop-filter: blur(10px);
    border-bottom:1px solid var(--border);
    overflow-x:auto;
    white-space:nowrap;
  }
  .navbar::-webkit-scrollbar{ height:0; }
  .navbar-inner{ display:flex; align-items:center; gap:2px; padding:0 14px; max-width:1040px; margin:0 auto; }
  .navbar a{
    font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:0.4px;
    color:var(--muted); text-decoration:none; padding:13px 12px;
    border-bottom:2px solid transparent; white-space:nowrap;
    transition: color .2s, border-color .2s;
  }
  .navbar a:hover{ color:var(--text); border-bottom-color:var(--gold); }
  .navbar .brand{ color:var(--gold); font-weight:700; padding-right:16px; border-right:1px solid var(--border); margin-right:6px; }

  .wrap{ max-width:1040px; margin:0 auto; padding:0 16px 90px; }

  /* ---------- hero ---------- */
  .hero{ padding:56px 16px 34px; text-align:center; position:relative; }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'IBM Plex Mono',monospace; font-size:11px; letter-spacing:1.5px;
    color:var(--gold); text-transform:uppercase; margin-bottom:18px;
  }
  .eyebrow::before, .eyebrow::after{ content:''; width:22px; height:1px; background:var(--gold); opacity:.5; }
  h1{
    font-size:clamp(26px,4.6vw,42px); line-height:1.25; margin:0 0 10px; font-weight:700;
    letter-spacing:-0.3px;
  }
  h1 .accent{ color:var(--buy); }
  .hero-sub{ color:var(--muted); font-size:14.5px; max-width:620px; margin:0 auto 30px; line-height:1.8; }

  .ticker{
    border-top:1px solid var(--border); border-bottom:1px solid var(--border);
    overflow:hidden; padding:10px 0; margin-bottom:8px;
  }
  .ticker-track{ display:flex; width:max-content; animation: scrollTicker 26s linear infinite; }
  .ticker-item{
    font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--muted);
    padding:0 26px; display:flex; align-items:center; gap:8px; flex-shrink:0;
  }
  .ticker-item b{ color:var(--text); font-weight:600; }
  .ticker-item.up{ color:var(--buy); }
  .ticker-item.down{ color:var(--sell); }
  @keyframes scrollTicker{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }

  /* ---------- section headers ---------- */
  .section{ margin-top:64px; scroll-margin-top:64px; }
  .section-head{ display:flex; align-items:baseline; gap:12px; margin-bottom:18px; }
  .section-num{ font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--muted-2); }
  .section-head h2{ font-size:19px; margin:0; font-weight:700; }
  .section-desc{ color:var(--muted); font-size:13px; line-height:1.75; margin:-8px 0 20px; max-width:720px; }

  /* ---------- generic card ---------- */
  .card{
    background:var(--panel); border:1px solid var(--border); border-radius:12px;
    padding:20px; margin-bottom:22px;
  }
  .card h3{ font-size:16px; margin:0 0 4px; color:var(--text); }
  .card p.desc{ font-size:12.5px; color:var(--muted); margin:0 0 16px; line-height:1.7; }

  /* ---------- workflow (daily -> 4h -> 15m) ---------- */
  .flow{ display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  .flow-step{
    background:var(--panel-2); border:1px solid var(--border-soft); border-radius:10px;
    padding:16px; position:relative;
  }
  .flow-step .fnum{
    font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--gold);
    border:1px solid var(--gold); border-radius:100px; width:22px; height:22px;
    display:flex; align-items:center; justify-content:center; margin-bottom:10px;
  }
  .flow-step h4{ margin:0 0 6px; font-size:14px; }
  .flow-step p{ margin:0; font-size:12px; color:var(--muted); line-height:1.7; }
  .flow-arrow{
    display:none; align-items:center; justify-content:center; color:var(--muted-2); font-size:18px;
  }
  @media(min-width:760px){
    .flow{ grid-template-columns:1fr auto 1fr auto 1fr; align-items:stretch; }
    .flow-arrow{ display:flex; }
  }
  @media(max-width:759px){ .flow{ grid-template-columns:1fr; } }

  /* ---------- supply/demand basic explainer ---------- */
  .sd-row{ display:flex; gap:16px; flex-wrap:wrap; align-items:stretch; }
  .sd-box{ flex:1; min-width:260px; }
  .sd-box svg{ display:block; width:100%; height:auto; background:var(--bg-chart); border-radius:8px; }
  .sd-legend{ display:flex; gap:18px; margin-top:12px; flex-wrap:wrap; }
  .sd-legend span{ display:flex; align-items:center; gap:7px; font-size:12px; color:var(--muted); }
  .sd-dot{ width:10px; height:10px; border-radius:3px; display:inline-block; }

  /* ---------- rule chip row (core rule) ---------- */
  .chiprow{ display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:12px; }
  .chip{
    background:var(--panel-2); border:1px solid var(--border-soft); border-left:3px solid var(--gold);
    border-radius:8px; padding:13px 14px;
  }
  .chip b{ display:block; font-size:12.5px; color:var(--gold); margin-bottom:4px; font-family:'IBM Plex Mono',monospace; letter-spacing:.3px;}
  .chip span{ font-size:12.5px; color:var(--muted); line-height:1.7; }

  /* ---------- model cards ---------- */
  .model-card{
    background:var(--panel); border:1px solid var(--border); border-radius:14px;
    padding:22px; margin-bottom:30px; scroll-margin-top:64px;
  }
  .model-head{ display:flex; align-items:center; gap:12px; margin-bottom:6px; flex-wrap:wrap; }
  .model-index{
    font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--bg);
    background:var(--gold); border-radius:6px; width:26px; height:26px;
    display:flex; align-items:center; justify-content:center; font-weight:700; flex-shrink:0;
  }
  .model-card h2{ font-size:18px; margin:0; }
  .model-card .desc{ font-size:12.5px; color:var(--muted); margin:6px 0 18px; line-height:1.75; max-width:680px; }

  /* step tracker */
  .steps{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px; }
  .step{
    display:flex; align-items:center; gap:7px; background:var(--panel-2);
    border:1px solid var(--border-soft); border-radius:100px; padding:6px 12px 6px 6px;
  }
  .step .n{
    width:19px; height:19px; border-radius:50%; background:var(--gold); color:var(--bg);
    font-family:'IBM Plex Mono',monospace; font-size:10px; font-weight:700;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .step .t{ font-size:11.5px; color:var(--text); }

  .row{ display:flex; gap:16px; flex-wrap:wrap; }
  .panel{ flex:1; min-width:300px; background:var(--bg-chart); border:1px solid var(--border-soft); border-radius:10px; padding:12px; position:relative; overflow:hidden; }
  .panel svg{ display:block; width:100%; height:auto; }
  .tag{
    position:absolute; top:14px; left:16px; font-family:'IBM Plex Mono',monospace;
    font-size:11px; font-weight:700; letter-spacing:0.6px; padding:4px 10px 4px 8px;
    border-radius:5px; z-index:2; display:flex; align-items:center; gap:5px;
  }
  .tag.buy{ color:var(--buy); background:var(--buy-soft); border:1px solid var(--buy); }
  .tag.sell{ color:var(--sell); background:var(--sell-soft); border:1px solid var(--sell); }
  .panel-label{
    position:absolute; bottom:10px; right:14px; font-family:'IBM Plex Mono',monospace;
    font-size:10px; color:var(--muted-2); letter-spacing:.3px;
  }

  .zz-line{ fill:none; stroke:#e8edf1; stroke-width:2.2; }

  .entry-zone{ fill-opacity:.35; }
  .sweep-dot,.entry-dot{ transform-box: fill-box; transform-origin:center; }

  /* ---------- notes / rule callouts ---------- */
  .notes{ margin-top:18px; display:grid; gap:10px; }
  .rule{
    display:flex; gap:12px; align-items:flex-start; background:var(--panel-2);
    border:1px solid var(--border-soft); border-radius:9px; padding:12px 14px;
  }
  .rule .ico{
    flex-shrink:0; width:26px; height:26px; border-radius:7px; display:flex; align-items:center;
    justify-content:center; font-size:13px; margin-top:1px;
  }
  .rule.info .ico{ background:var(--blue-soft); color:var(--blue); }
  .rule.warn .ico{ background:var(--sell-soft); color:var(--sell); }
  .rule.ok .ico{ background:var(--buy-soft); color:var(--buy); }
  .rule .body{ font-size:12.8px; color:#d7dde1; line-height:1.75; }
  .rule .body b{ color:#fff; }
  .rule-label{
    font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.4px;
    text-transform:uppercase; display:block; margin-bottom:3px;
  }
  .rule.info .rule-label{ color:var(--blue); }
  .rule.warn .rule-label{ color:var(--sell); }
  .rule.ok .rule-label{ color:var(--buy); }

  /* ---------- usage matrix (continuation vs reversal) ---------- */
  .usage-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; }
  .usage-card{ border-radius:12px; padding:19px; border:1px solid var(--border); }
  .usage-card.reversal{ background:linear-gradient(180deg,var(--blue-soft),transparent 60%),var(--panel); border-color:#2c4a72; }
  .usage-card.continuation{ background:linear-gradient(180deg,var(--gold-soft),transparent 60%),var(--panel); border-color:#5c4a25; }
  .usage-card h4{ margin:0 0 4px; font-size:15px; display:flex; align-items:center; gap:8px; }
  .usage-card p.sub{ margin:0 0 14px; font-size:12px; color:var(--muted); }
  .usage-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px; }
  .usage-list li{
    font-size:12.5px; display:flex; gap:9px; align-items:flex-start; color:#d7dde1; line-height:1.65;
  }
  .pill-ok{ font-family:'IBM Plex Mono',monospace; font-size:10px; background:var(--buy-soft); color:var(--buy); border:1px solid var(--buy); border-radius:5px; padding:1px 6px; flex-shrink:0; margin-top:2px;}
  .pill-no{ font-family:'IBM Plex Mono',monospace; font-size:10px; background:var(--sell-soft); color:var(--sell); border:1px solid var(--sell); border-radius:5px; padding:1px 6px; flex-shrink:0; margin-top:2px;}

  /* ---------- checklist (numbered vertical steps) ---------- */
  .checklist{ display:flex; flex-direction:column; gap:0; margin-bottom:22px; }
  .check-item{
    display:flex; gap:14px; padding:13px 0; border-bottom:1px solid var(--border-soft);
  }
  .check-item:last-child{ border-bottom:none; }
  .check-item .cnum{
    flex-shrink:0; width:26px; height:26px; border-radius:7px; background:var(--panel-2);
    border:1px solid var(--gold); color:var(--gold); font-family:'IBM Plex Mono',monospace;
    font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center;
  }
  .check-item b{ display:block; font-size:13px; color:var(--text); margin-bottom:3px; }
  .check-item span{ font-size:12.5px; color:var(--muted); line-height:1.7; }

  /* ---------- process chain (horizontal cause->effect steps) ---------- */
  .chain{ display:flex; flex-wrap:wrap; align-items:stretch; gap:0; margin-bottom:20px; }
  .chain-step{
    flex:1; min-width:150px; background:var(--panel-2); border:1px solid var(--border-soft);
    border-radius:9px; padding:13px 14px; position:relative;
  }
  .chain-step b{ display:block; font-size:12.5px; color:var(--gold); margin-bottom:4px; font-family:'IBM Plex Mono',monospace; }
  .chain-step span{ font-size:12px; color:var(--muted); line-height:1.65; }
  .chain-arrow{ display:flex; align-items:center; justify-content:center; padding:0 10px; color:var(--muted-2); font-size:16px; }
  @media(max-width:700px){ .chain{ flex-direction:column; } .chain-arrow{ transform:rotate(90deg); padding:2px 0; } }

  /* ---------- term grid (definitions) ---------- */
  .termgrid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:10px; margin-bottom:20px; }
  .term{
    background:var(--panel-2); border:1px solid var(--border-soft); border-radius:8px; padding:12px 14px;
  }
  .term b{ display:block; font-size:12.5px; color:var(--blue); margin-bottom:4px; font-family:'IBM Plex Mono',monospace; }
  .term span{ font-size:12px; color:var(--muted); line-height:1.65; }

  /* ---------- decision table ---------- */
  .dtable{ width:100%; border-collapse:collapse; margin-bottom:20px; font-size:12.5px; }
  .dtable th{ text-align:right; font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:.4px; text-transform:uppercase; color:var(--muted-2); padding:8px 12px; border-bottom:1px solid var(--border); }
  .dtable td{ padding:10px 12px; border-bottom:1px solid var(--border-soft); color:#d7dde1; }
  .dtable tr:last-child td{ border-bottom:none; }
  .dtable .v-ok{ color:var(--buy); font-weight:700; font-family:'IBM Plex Mono',monospace; font-size:11.5px; }
  .dtable .v-no{ color:var(--sell); font-weight:700; font-family:'IBM Plex Mono',monospace; font-size:11.5px; }
  [dir="rtl-fix"]{}
  .dtable th:first-child, .dtable td:first-child{ text-align:right; }

  /* ---------- valid / invalid loss ---------- */
  .loss-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:16px; }
  .loss-card{ background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:19px; }
  .loss-card.valid{ border-top:3px solid var(--blue); }
  .loss-card.invalid{ border-top:3px solid var(--sell); }
  .loss-card h4{ margin:0 0 10px; font-size:14.5px; display:flex; align-items:center; gap:8px; }
  .loss-card ul{ margin:0; padding-left:18px; }
  .loss-card li{ font-size:12.5px; color:#d7dde1; line-height:1.8; margin-bottom:6px; }

  /* ---------- summary ---------- */
  .summary-card{
    border-radius:12px; padding:22px; border:1px solid #3a2f19;
    background:linear-gradient(135deg,var(--gold-soft),transparent 70%), var(--panel);
  }
  .summary-card h3{ color:var(--gold); margin:0 0 14px; font-size:15px; font-family:'IBM Plex Mono',monospace; letter-spacing:.3px; }
  .summary-card ul{ margin:0; padding-left:18px; }
  .summary-card li{ font-size:13px; color:#e3e8eb; line-height:1.85; margin-bottom:7px; }
  .summary-card li b{ color:var(--gold); }

  footer{
    text-align:center; margin-top:70px; padding-top:26px; border-top:1px solid var(--border);
    color:var(--muted-2); font-size:11.5px; font-family:'IBM Plex Mono',monospace; line-height:2;
  }
  footer .h{ color:var(--muted); }
</style>
</head>
