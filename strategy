  <!-- ============ 6. WHEN TO USE WHICH ============ -->
  <section class="section" id="usage">
    <div class="section-head"><span class="section-num mono">03</span><h2>መቼ የትኛውን ሞዴል እንጠቀማለን?</h2></div>
    <p class="section-desc">ማርኬቱ ምን እያደረገ እንዳለ (አዲስ አቅጣጫ እየፈጠረ ወይስ ነባር ትሬንድ እየቀጠለ) በመመስረት፣ ከ3ቱ ሞዴል የትኛው ተግባራዊ እንደሚሆን ይለያያል።</p>
    <div class="usage-grid">
      <div class="usage-card reversal">
        <h4>🔄 ሪቨርሳል — ማርኬቱ አቅጣጫ ሲቀይር</h4>
        <p class="sub">ማርኬቱ ከነበረበት ትሬንድ ውጪ አዲስ አቅጣጫ ለመፍጠር ሲሞክር።</p>
        <ul class="usage-list">
          <li><span class="pill-ok">OK</span>ፌክ አውት</li>
          <li><span class="pill-ok">OK</span>ኦርደር ፍሎ ሽፍት</li>
          <li><span class="pill-ok">OK</span>ፍሊፕ</li>
          <li><span class="pill-ok">OK</span>ሶስቱም ሞዴል ያገለግላሉ</li>
        </ul>
      </div>
      <div class="usage-card continuation">
        <h4>➡️ ኮንቲኔሽን — ነባር ትሬንድ ሲቀጥል</h4>
        <p class="sub">ማርኬቱ ቀድሞ ወደ ነበረበት ዋና አቅጣጫ ብቻ ሲቀጥል።</p>
        <ul class="usage-list">
          <li><span class="pill-ok">OK</span>ፌክ አውት</li>
          <li><span class="pill-ok">OK</span>ኦርደር ፍሎ ሽፍት</li>
          <li><span class="pill-no">NO</span>ፍሊፕ አይጠቀምም</li>
          <li><span class="pill-ok">OK</span><b style="color:#e3a94a">ማኒፑሌሽን ግድ ነው</b> — ፑልባክ ፈጥሮ ወደ ተቃራኒ ማሳየት አለበት፣ ከሌለ ትሬድ የለም</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 7. VALID VS INVALID LOSS ============ -->
  <section class="section" id="lossreview">
    <div class="section-head"><span class="section-num mono">04</span><h2>ሎስ ስንገመግም — ቫሊድ ሎስ vs ኢንቫሊድ ሎስ</h2></div>
    <p class="section-desc">ባክቴስት ስናደርግ እያንዳንዱን ሉዚንግ ትሬድ በጥሞና መገምገም ያስፈልጋል። ሁሉም ሎስ ስህተት አይደለም — ስትራቴጂው 100% አያሸንፍም፣ ፕሮባቢሊቲ ብቻ ነው።</p>
    <div class="loss-grid">
      <div class="loss-card valid">
        <h4 style="color:var(--blue)">◆ ቫሊድ ሎስ (ተቀባይነት ያለው)</h4>
        <ul>
          <li>ሶስቱም ኢንትሪ ደንቦች ሙሉ በሙሉ ተከትለን ገብተናል፣ ግን ማርኬቱ በተቃራኒ ሄዷል።</li>
          <li>ኤስኤላችን በትክክለኛው ቦታ (ከቦዲው ውጪ ማርጅን ጨምረን) ተቀምጦ ነበር።</li>
          <li>ከሃየር ታይም ፍሬም አንፃርም ቢሆን ቴክኒካሊ ትክክለኛ ውሳኔ ነበር።</li>
          <li>➜ ይሄ በቃ <b style="color:#fff">ፕሮባቢሊቲ</b> ነው፤ ማንም ስትራቴጂ 100% አያሸንፍም — ተቀብለን እንቀጥላለን።</li>
        </ul>
      </div>
      <div class="loss-card invalid">
        <h4 style="color:var(--sell)">✕ ኢንቫሊድ ሎስ (የደንብ ጥሰት)</h4>
        <ul>
          <li>ማርኬቱ ወደ ኢንትሪ ዞናችን ገና <b>ፑልባክ ሰርቶ</b> እየመጣ ሳለ ቀድመን ገብተናል።</li>
          <li>ፌክ አውት/ሽፍት/ፍሊፕ ደረጃው ገና <b>ሳይደርስ</b> ወይም <b>ሳይመጣ</b> ገብተናል።</li>
          <li>ተዛማጅ (correlated) ጥንድ ወይም ኢንዴክስ (ለምሳሌ DXY vs USDJPY) <b>የሚጋጭ መረጃ</b> ሲሰጡ ትሬዱን ችላ ብለን ገብተናል — ሁለት የሚጋጭ መረጃ ሲኖር ትሬዱን ማስቀረት ነበረብን።</li>
          <li>➜ ይሄ <b style="color:#fff">ስህተት</b> ነው — ለቀጣይ ትሬድ እንደ ትምህርት እንይዘዋለን፣ አንደግመውም።</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 8. SUMMARY ============ -->
  <section class="section" id="summary">
    <div class="section-head"><span class="section-num mono">05</span><h2>ማጠቃለያ ደንቦች</h2></div>
    <div class="summary-card">
      <h3 class="mono">🔑 GENERAL RULES — ለሶስቱም ሞዴሎች</h3>
      <ul>
        <li>ከ3ቱ ኢንትሪ ሞዴል <b>አንዱ ብቻ</b> መሟላት አለበት ማርኬት ውስጥ ለመግባት — ምንም ካላሟላ <b>አንገባም</b>።</li>
        <li>ፑልባክ ካለው ብቻ፡ <b>ፌክ አውት</b> ወይም <b>ኦርደር ፍሎ ሽፍት</b> እንጠቀማለን። ፑልባክ ከሌለው (single leg)፡ <b>ፍሊፕ</b> ብቻ እንጠቀማለን።</li>
        <li>ኮንቲኔሽን ትሬድ ላይ ፍሊፕ አንጠቀምም — <b>ማኒፑሌሽን</b> ብቻ ነው የምንፈልገው (ፌክ አውት ወይም ኦርደር ፍሎ ሽፍት)።</li>
        <li>ኢንትሪ ዞን ሁልጊዜ <b>ከዊኩ እስከ ቦዲው</b> ብቻ ነው፤ ኤስኤል ደግሞ ከቦዲው ውጪ ተጨማሪ ማርጅን ይይዛል።</li>
        <li>ማንኛውም ትሬድ 100% ዋስትና የለውም — <b>ፕሮባቢሊቲ</b> ብቻ ነው፤ ትክክለኛ ኤስኤል/ሪስክ ማኔጅመንት ማድረግ ግድ ነው።</li>
        <li>ውሳኔ ከመስጠትዎ በፊት ሁልጊዜ ወደ <b>ከፍ ያለ ታይም ፍሬም</b> እና ተዛማጅ ገበያዎች ተመልከቱ — የሚጋጭ መረጃ ካለ ትሬዱን አስቀሩ።</li>
      </ul>
    </div>
  </section>

